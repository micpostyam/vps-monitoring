# Copier en .env dans /opt/monitoring/ sur le VPS.
# Ce fichier n'est jamais committé (cf. .gitignore).

# ─── Exposition ──────────────────────────────────────────────────────────────
# Domaine servant Grafana.
MONITORING_DOMAIN=monitor.ustudyguide.com

# Resolver Traefik, à choisir selon l'hébergeur de la zone DNS :
#   letsencrypt      → challenge HTTP-01, marche pour toute zone (LWS, OVH…)
#   letsencrypt-dns  → challenge DNS via l'API Cloudflare, réservé aux zones
#                      Cloudflare (ustdy.com et ses wildcards)
# ustudyguide.com est chez LWS : c'est donc letsencrypt.
MONITORING_CERT_RESOLVER=letsencrypt

# ─── Accès ───────────────────────────────────────────────────────────────────
# Mot de passe du compte admin Grafana (login : admin).
GF_SECURITY_ADMIN_PASSWORD=changez-moi

# BasicAuth Traefik, deuxième barrière devant Grafana.
# Générer AVEC le doublement des $ — Compose en consomme un sur deux :
#   htpasswd -nb admin 'VotreMotDePasse' | sed -e 's/\$/\$\$/g'
# (paquet apache2-utils). Sans le doublement, Compose prend $apr1 pour une
# variable vide et le hash disparaît. Vérifier après démarrage avec le
# `docker inspect` donné dans le README — `docker compose config` ne le montre pas.
MONITORING_BASIC_AUTH=admin:$$apr1$$exemple$$remplacez-cette-valeur
