    {
      "type": "table",
      "title": "Croissance mémoire sur 24 h",
      "description": "Classement par mémoire GAGNÉE en 24 h. Une charge normale revient à zéro ; une fuite reste positive jour après jour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 104857600
              },
              {
                "color": "red",
                "value": 524288000
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Croissance"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Croissance"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sort_desc(delta(container_memory_working_set_bytes{name!=\"\", container_label_com_docker_compose_project=~\"$projet\"}[24h]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {
