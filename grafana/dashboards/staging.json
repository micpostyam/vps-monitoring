{
  "uid": "staging",
  "title": "Staging — tous environnements",
  "description": "Tout conteneur dont le projet Compose ou le nom contient « staging ». Rien à déclarer : un environnement déployé demain apparaît ici tout seul.",
  "tags": [
    "infra",
    "vps",
    "staging"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Vue d'ensemble — staging",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Conteneurs staging",
      "description": "Nombre de conteneurs découverts. Aucune liste : le compte suit les déploiements.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "count(container_memory_working_set_bytes{name!=\"\", container_label_com_docker_compose_project=~\".*staging.*\"} or container_memory_working_set_bytes{name=~\".*staging.*\"})",
          "legendFormat": "",
          "range": true,
          "instant": false,
          "format": "time_series",
          "refId": "A"
        }
      ]
    },
